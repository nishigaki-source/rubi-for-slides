{
  "name": "rubi-for-slides",
  "version": "0.1.10",
  "private": true,
  "description": "Googleスライドの漢字にルビ（ひらがな）を表示・書き込みするChrome拡張機能",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/sync-dict.mjs",
    "sync-dict": "node scripts/sync-dict.mjs",
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:e2e": "vite build --config vite.e2e.config.ts",
    "test:e2e": "npm run build:e2e && playwright test",
    "lint": "eslint . --ext .ts",
    "build:store-zip": "npm run build && node scripts/build-store-zip.mjs"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.31",
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.0.280",
    "@types/kuromoji": "^0.1.3",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^9.15.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-node-polyfills": "^0.22.0",
    "vitest": "^2.1.5"
  },
  "dependencies": {
    "kuromoji": "^0.1.2",
    "pako": "^3.0.2"
  }
}
